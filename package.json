{
  "name": "radici-san-giovanni-lipioni",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "node ./node_modules/vitest/vitest.mjs run src/app/app.spec.ts src/app/core/services/chatbot.service.spec.ts src/app/core/services/audio-guide.service.spec.ts src/app/core/services/offline-content.service.spec.ts --environment jsdom --globals --pool vmThreads --maxWorkers=1 --no-isolate",
    "test:place-coordinates": "node --test scripts/validate-place-coordinates.test.mjs",
    "validate:place-coordinates": "node scripts/validate-place-coordinates.mjs",
    "test:place-data": "node --test scripts/validate-place-data.test.mjs",
    "validate:place-data": "node scripts/validate-place-data.mjs",
    "test:timeline-data": "node --test scripts/validate-timeline-data.test.mjs",
    "validate:timeline-data": "node scripts/validate-timeline-data.mjs",
    "test:itinerary-data": "node --test scripts/validate-itinerary-data.test.mjs",
    "validate:itineraries": "node scripts/validate-itinerary-data.mjs",
    "test:publication-readiness": "node --test scripts/validate-publication-readiness.test.mjs",
    "validate:publication-ready": "node scripts/validate-publication-readiness.mjs",
    "test:place-validation": "npm run test:place-coordinates && npm run test:place-data && npm run test:timeline-data && npm run test:itinerary-data && npm run test:publication-readiness",
    "validate:places": "npm run validate:place-coordinates && npm run validate:place-data && npm run validate:timeline-data && npm run validate:itineraries",
    "mobile:build": "npm run build && npx cap sync",
    "mobile:sync": "npx cap sync",
    "mobile:add:android": "npm run build && npx cap add android",
    "mobile:add:ios": "npm run build && npx cap add ios",
    "mobile:android": "npm run build && npx cap run android",
    "mobile:android:debug": "npm run mobile:build && cd android && gradlew.bat assembleDebug",
    "mobile:android:apk": "powershell -ExecutionPolicy Bypass -File scripts/build-android-apk.ps1",
    "mobile:android:release": "powershell -ExecutionPolicy Bypass -File scripts/build-android-release.ps1",
    "mobile:ios": "npm run build && npx cap run ios",
    "serve:ssr:radici-san-giovanni-lipioni": "node dist/radici-san-giovanni-lipioni/server/server.mjs",
    "lint": "ng lint",
    "test:production": "node --test scripts/production-server.test.mjs",
    "test:e2e": "playwright test"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/forms": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "@angular/platform-server": "22.2.6",
    "@angular/router": "22.2.6",
    "@angular/service-worker": "22.2.6",
    "@angular/ssr": "22.2.7",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@types/leaflet": "^1.9.21",
    "express": "^5.1.0",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.7",
    "@angular/cli": "22.2.7",
    "@angular/compiler-cli": "22.2.6",
    "@axe-core/playwright": "^4.14.1",
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "angular-eslint": "^22.8.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "4.1.12"
  }
}
